# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# For server-side operations (KEEP SECRET - don't commit EVER!)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cron job authentication (set in Vercel dashboard)
CRON_SECRET=your_cron_secret_here

# Distributed rate limiting (use one complete pair; production requires it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively: KV_REST_API_URL / KV_REST_API_TOKEN
RATE_LIMIT_REQUIRE_DISTRIBUTED=false

# Error reporting (browser DSN must be present at build time)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Uptime monitor bearer token: generate at least 32 random characters
HEALTH_TOKEN=

# Relaunch switches: server-authoritative, exact "true" enables; default off.
FEATURE_DISCOVERY_UI=false
# Optional active-admin-only discovery preview while public discovery is off.
FEATURE_DISCOVERY_ADMIN_PREVIEW=false
FEATURE_NATIVE_APPLICATIONS=false
FEATURE_RECRUITER_ACCESS=false
FEATURE_RESUME_PARSING=false
FEATURE_NEW_FEEDBACK_WRITES=false
# Verified admin user's UUID, never an email/domain or client metadata claim.
# Empty means no one can assign Ady's Pick or editorial priority.
CURATOR_USER_ID=
